# --- LLM ---
GROQ_API_KEY=gsk_...
LLM_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# --- Embedding ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Vector Store ---
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIR=./data/chroma
QDRANT_URL=http://localhost:6333

# --- Retrieval ---
TOP_K=10
DISTANCE_THRESHOLD=0.40

# --- Server ---
API_HOST=0.0.0.0
API_PORT=8000
